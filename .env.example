# Koshmoney.com — environment template
# Copy to .env.local (gitignored) and fill in real values.
# Everything prefixed NEXT_PUBLIC_ is inlined into the client bundle — it is
# public by definition. Never put a real secret behind that prefix.

NODE_ENV=development

# ---- Site ----
# Absolute origin, used for canonical URLs, sitemap and OG image URLs.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Backend API ----
# Public referral lookup, lead relay, etc. Server-side and client-side copies.
BACKEND_API=
NEXT_PUBLIC_BACKEND_API=

# ---- Product links ----
NEXT_PUBLIC_DASHBOARD_LINK=
NEXT_PUBLIC_CONTACT_US_LINK=
NEXT_PUBLIC_CORPORATE_CONTACT_US_LINK=

# ---- Analytics (all client-side, publishable IDs) ----
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_INTERCOM_ID=
NEXT_PUBLIC_AMPLITUDE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_CUSTOMER_IO_SITE_ID=
NEXT_PUBLIC_CUSTOMER_IO_ODYSSEY_FORM_ID=

# ---- Bot protection (Cloudflare Turnstile) ----
# Dev can use Cloudflare's always-pass test pair:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# The secret is verified server-side in /api/lead — set the REAL one only as a
# deployment secret, never in a committed file.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Lead relay ----
# Blank in dev -> the form posts to same-origin /api/lead.
NEXT_PUBLIC_LEAD_WORKER_URL=

# ---- Attribution (AppsFlyer OneLink) ----
NEXT_PUBLIC_ONELINK_DOMAIN=
NEXT_PUBLIC_ONELINK_TEMPLATE=

# ---- Media ----
# Cloudflare image/video transform prefix; blank serves assets untransformed.
NEXT_PUBLIC_CF_MEDIA_TRANSFORM=
