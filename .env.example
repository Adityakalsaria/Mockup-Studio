# Mockup Studio — environment template
# Copy to .env.local (gitignored) and fill in real values.
# Everything prefixed NEXT_PUBLIC_ is inlined into the client bundle — it is
# public by definition. Never put a real secret behind that prefix.

NODE_ENV=development

# ---- Site ----
# Absolute origin, used for canonical URLs, sitemap and OG image URLs.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Both are public by design and belong in the client bundle: the URL is an
# address, the anon key identifies the PROJECT rather than the caller. Neither
# grants access on its own -- row-level security decides what a signed-in user
# may read or write, which is why RLS is enabled on every table.
# The service_role key is the opposite of these. It bypasses RLS entirely, must
# never carry the NEXT_PUBLIC_ prefix, and is not needed by anything here.
#
# Supabase now issues PUBLISHABLE keys (sb_publishable_...) and treats the older
# anon key as legacy. Either works in this slot -- the variable keeps its name so
# nothing has to be renamed when the project is migrated.
NEXT_PUBLIC_SUPABASE_URL=https://aazeghdurjzlflbhfaju.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Backend API ----
# Public referral lookup, lead relay, etc. Server-side and client-side copies.
BACKEND_API=
NEXT_PUBLIC_BACKEND_API=

# ---- Product links ----
NEXT_PUBLIC_DASHBOARD_LINK=
NEXT_PUBLIC_CONTACT_US_LINK=
NEXT_PUBLIC_CORPORATE_CONTACT_US_LINK=

# ---- Analytics (all client-side, publishable IDs) ----
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_INTERCOM_ID=
NEXT_PUBLIC_AMPLITUDE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_CUSTOMER_IO_SITE_ID=
NEXT_PUBLIC_CUSTOMER_IO_ODYSSEY_FORM_ID=

# ---- Bot protection (Cloudflare Turnstile) ----
# Dev can use Cloudflare's always-pass test pair:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# The secret is verified server-side in /api/lead — set the REAL one only as a
# deployment secret, never in a committed file.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Lead relay ----
# Blank in dev -> the form posts to same-origin /api/lead.
NEXT_PUBLIC_LEAD_WORKER_URL=

# ---- Attribution (AppsFlyer OneLink) ----
NEXT_PUBLIC_ONELINK_DOMAIN=
NEXT_PUBLIC_ONELINK_TEMPLATE=

# ---- Media ----
# Cloudflare image/video transform prefix; blank serves assets untransformed.
NEXT_PUBLIC_CF_MEDIA_TRANSFORM=
